{
  "expo": {
    "name": "Flowsy",
    "slug": "LifeOS",
    "scheme": "lifeos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.flowsy.app",
      "adaptiveIcon": {
        "backgroundColor": "#08192A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "versionCode": 61
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-blank.png",
          "imageWidth": 1,
          "backgroundColor": "#F9FAFB",
          "dark": {
            "backgroundColor": "#0B0D12"
          }
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#145AFC"
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Flowsy to access your photos to set a profile picture or attach to a post.",
          "cameraPermission": "Allow Flowsy to use your camera to take a photo for your post."
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Flowsy to use your camera to scan food."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Flowsy to access your location to record your route while a run, walk, or activity is in progress, even when the app is in the background.",
          "locationWhenInUsePermission": "Allow Flowsy to access your location to record your route while a run, walk, or activity is in progress.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Flowsy to use Face ID to unlock the app."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Flowsy to save your activity and post images to your photos.",
          "savePhotosPermission": "Allow Flowsy to save your activity and post images to your photos.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Flowsy to use the microphone for voice commands.",
          "speechRecognitionPermission": "Allow Flowsy to use speech recognition for voice commands."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "allowBackup": false
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2f279934-133d-47fc-af3a-a8f928b4e541"
      }
    }
  }
}
